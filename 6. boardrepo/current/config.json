  "browser": {
    "headless": false,
    "login_wait_seconds": 180,
    "operation_timeout_ms": 15000,
    "mode": "auto",
    "auto_order": [
      "playwright_chromium",
      "msedge"
    ],
    "msedge_channel": "msedge",
    "edge_launch_strategy": "channel_then_executable",
    "preserve_legacy_chromium_profile": true,
    "browser_download_policy": "never_by_default"
  },
  "upload": {
    "title_template": "[BoardRepo] {display_name}_{version}",
    "body_template": "BoardRepo 자동 백업 업로드입니다.\n\n프로젝트 : {display_name}\n버전 : {version}\n업로드일 : {created}\n원본 폴더 : {source_folder}\n첨부 파일 : {zip_name}\n\n대상 폴더에서 최신 규칙으로 자동 선택된 압축파일입니다.\n필요 시 첨부된 파일을 내려받아 해당 시점의 파일로 복원할 수 있습니다."
  },
  "archive_selection": {
    "extensions": [
      ".zip",
      ".7z",
      ".rar"
    ],
    "date_format": "YYMMDD",
    "date_first": true,
    "same_date_order": [
      "rev",
      "counter"
    ],
    "no_date_order": [
      "rev",
      "counter"
    ],
    "mixed_date_policy": "stop_and_warn",
    "date_rev_conflict_policy": "stop_and_warn",
    "tie_policy": "stop_and_warn",
    "require_revision": true,
    "recursive": false,
    "strategies": {
      "date_counter_release": {
        "require_date": true,
        "revision_required": false,
        "order": [
          "date",
          "counter"
        ],
        "allow_missing_counter_if_unique_date": true,
        "legacy_rev_token_policy": "ignore_for_ordering"
      },
      "date_rev_counter": {
        "require_date": false,
        "revision_required": true,
        "order": [
          "date",
          "rev",
          "counter"
        ],
        "mixed_date_policy": "stop_and_warn",
        "date_rev_conflict_policy": "stop_and_warn"
      }
    }
  },
  "remote_duplicate_check": {
    "enabled": true,
    "max_board_pages": 10,
    "page_wait_ms": 500,
    "next_page_text_candidates": [
      "다음"
    ],
    "standard_match_exact_title": true,
    "standard_match_exact_filename_text": true,
    "ext_same_name_missing_sha_policy": "conflict",
    "ext_same_name_different_sha_policy": "conflict",
    "ext_post_detail_wait_seconds": 5,
    "ext_post_detail_poll_ms": 300,
    "board_ready_timeout_seconds": 10,
    "board_ready_poll_ms": 500,
    "empty_scan_retries": 3,
    "empty_scan_retry_ms": 1000,
    "diagnostic_logging": true,
    "row_textcontent_matching": true,
    "unconfirmed_board_policy": "error_skip",
    "empty_board_text_candidates": [
      "게시글이 없습니다",
      "등록된 게시글이 없습니다",
      "검색된 게시물이 없습니다",
      "등록된 글이 없습니다"
    ],
    "detail_navigation_timeout_seconds": 8,
    "detail_navigation_poll_ms": 250,
    "reuse_shared_row_navigation": true
  },
  "ext_upload": {
    "recursive": false,
    "exclude_hidden": true,
    "exclude_prefixes": [
      "~$"
    ],
    "exclude_names": [
      "Thumbs.db",
      "desktop.ini",
      ".DS_Store"
    ],
    "exclude_suffixes": [
      ".tmp",
      ".temp",
      ".part",
      ".crdownload",
      ".download",
      ".swp",
      ".lock"
    ],
    "title_template": "[BoardRepo][Ext] {filename}",
    "body_template": "BoardRepo 기타 자료 업로드입니다.\n\n파일명 : {filename}\n크기 : {size_bytes} bytes\nSHA-256 : {sha256}\n업로드일 : {created}\n원본 폴더 : {source_folder}\n\nExt 폴더에서 신규 자료로 판정되어 자동 업로드된 파일입니다."
  },
  "package_release": {
    "id": "260819_1",
    "distribution_name": "BoardRepo_260819_1",
    "filename_rule": "BoardRepo_YYMMDD_N.zip",
    "date_format": "YYMMDD",
    "counter_start": 1,
    "counter_resets_on_new_date": true
  },
  "batch_policy": {
    "local_preflight_error": "skip_item_and_continue",
    "duplicate": "skip_item_and_continue",
    "remote_conflict": "skip_item_and_continue",
    "remote_item_error": "skip_item_and_continue",
    "fatal_remote_session_error": "stop_all",
    "actual_upload_error": "skip_item_and_continue",
    "show_attention_warning": true,
    "show_summary_popup_on_duplicate": true,
    "show_summary_popup_on_attention": true,
    "show_summary_popup_on_upload_failure": true,
    "show_popup_when_all_success": false
  },
  "backup_upload": {
    "recursive": false,
    "exclude_hidden": true,
    "exclude_prefixes": [
      "~$"
    ],
    "exclude_names": [
      "Thumbs.db",
      "desktop.ini",
      ".DS_Store"
    ],
    "exclude_suffixes": [
      ".tmp",
      ".temp",
      ".part",
      ".crdownload",
      ".download",
      ".swp",
      ".lock"
    ],
    "extensions": [
      ".zip",
      ".7z",
      ".rar"
    ],
    "title_template": "[BoardRepo][Backup] {filename}",
    "body_template": "BoardRepo 압축자료 백업 업로드입니다.\n\n파일명 : {filename}\n크기 : {size_bytes} bytes\n업로드일 : {created}\n원본 폴더 : {source_folder}\n\nBackup 폴더의 압축파일 Inbox에서 신규 자료로 판정되어 자동 업로드된 파일입니다.",
    "latest_per_family": true,
    "release_pattern": "FAMILY_YYMMDD_N",
    "legacy_release_without_counter": true,
    "ignore_legacy_rev_before_date": true
  },
  "download": {
    "enabled": true,
    "max_board_pages": 10,
    "page_wait_ms": 500,
    "post_wait_ms": 500,
    "download_timeout_ms": 30000,
    "temporary_suffix": ".part",
    "overwrite_existing": false,
    "verify_ext_sha256": true,
    "verify_known_size": true,
    "versioned_policy": "remote_newer_only",
    "backup_policy": "remote_newer_per_family_only",
    "ext_policy": "missing_or_same_sha_skip_conflict_on_difference",
    "show_result_popup": true,
    "board_ready_timeout_seconds": 10,
    "board_ready_poll_ms": 500,
    "empty_scan_retries": 3,
    "empty_scan_retry_ms": 1000,
    "diagnostic_logging": true,
    "dom_fallback_enabled": true,
    "discovery_mode": "board_row_title_first",
    "validate_attachment_against_title": true,
    "invalid_boardrepo_post_policy": "ignore_and_log",
    "ext_process_all_valid_posts": true,
    "detail_ready_timeout_seconds": 8,
    "detail_ready_poll_ms": 250,
    "ext_sha_ready_grace_ms": 1000,
    "require_observed_attachment_metadata": true,
    "download_control_ready_timeout_seconds": 8,
    "download_control_ready_poll_ms": 250
  },
  "integration": {
    "catalog_path": "../../program_catalog.json",
    "target_count": 6,
    "automation_manager_is_managed_target": false
  },
  "environment": {
    "offline_first": true,
    "allow_online_pip_fallback": false,
    "allow_playwright_browser_download": false,
    "portable_vendor_enabled": true,
    "offline_wheelhouse": "offline_packages/windows_x64",
    "offline_requirements": "offline_requirements_windows.txt",
    "offline_prepare_platform": "win_amd64",
    "offline_prepare_python_versions": [
      "3.10",
      "3.11",
      "3.12",
      "3.13",
      "3.14"
    ],
    "company_mode_note": "외부 Chromium 다운로드 없이 기존 Chromium 우선, 없거나 실행 실패 시 설치된 Microsoft Edge 사용"
  }
}
